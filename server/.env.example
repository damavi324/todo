# ---------- Server ----------
PORT=5050
# Your public HTTPS host with no scheme, e.g. the ngrok domain: abcd-1234.ngrok-free.app
PUBLIC_HOST=
# Passcode to open the web app (strongly recommended: the app can place real phone calls)
APP_PASSCODE=

# ---------- Who the assistant works for ----------
OWNER_NAME=
# Name the AI uses to introduce itself on agent calls
ASSISTANT_NAME=Pilot
# Identity of the browser dialer (letters/numbers only)
CLIENT_IDENTITY=owner

# ---------- Twilio (console.twilio.com) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# API Key + Secret (Console > Account > API keys & tokens > Create API key, type Standard)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TwiML App SID (Console > Voice > TwiML > TwiML Apps). Its Voice URL = https://PUBLIC_HOST/twilio/outgoing
TWILIO_TWIML_APP_SID=
# A Twilio phone number you own, in E.164 (+1...). Used as caller ID.
TWILIO_PHONE_NUMBER=
# Optional: your own cell number, once verified in Twilio (Phone Numbers > Verified Caller IDs).
# If set, businesses see YOUR number instead of the Twilio number.
TWILIO_CALLER_ID=

# ---------- Deepgram (console.deepgram.com) ----------
DEEPGRAM_API_KEY=
# Live transcription model for copilot mode
DEEPGRAM_LISTEN_MODEL=nova-3
# Voice agent models (Flux = Deepgram's conversational models).
AGENT_LISTEN_MODEL=flux-general-en
# flux-miles-en is a calm, clear, friendly US male voice. Compare others with: npm run voices
AGENT_VOICE=flux-miles-en
AGENT_SPEED=1
# Keep 0: it's the only expressivity value Deepgram validates for production.
AGENT_EXPRESSIVITY=0
# Turn-taking (Flux): early "probably done" signal so replies start sooner (0.3-0.9, or off),
# and the longest wait in ms before treating a trailing-off speaker as done.
AGENT_EAGER_EOT=0.5
AGENT_EOT_TIMEOUT_MS=3000
# How long to wait for "Hello?" after pickup before the agent opens anyway
AGENT_HELLO_WAIT_MS=2000
# Claude model the voice agent thinks with. Deepgram runs claude-haiku-4-5 itself (included in its
# per-minute rate). Any other model, e.g. claude-haiku-5-5, goes through your ANTHROPIC_API_KEY
# and is billed by Anthropic; Deepgram's rate then drops to its "BYO LLM" price.
AGENT_THINK_MODEL=claude-haiku-4-5
# Force who runs it: deepgram | anthropic (empty = automatic, as above)
AGENT_THINK_ENDPOINT=

# ---------- Nepali calls (optional) ----------
# Calls the app starts in Nepali listen with Deepgram Nova-3 Nepali and speak with ElevenLabs (elevenlabs.io).
# Without a key and a voice, the app shows Nepali as unavailable.
ELEVENLABS_API_KEY=
# A voice from your ElevenLabs voice library that sounds good in Nepali
ELEVENLABS_VOICE_ID_NE=
# Real-time model (Nepali is supported in eleven_v4_turbo, eleven_v4 and eleven_v3; not in Flash v2.5)
ELEVENLABS_MODEL_NE=eleven_v4_turbo
# Tried if the main model fails (slower); off to turn off
ELEVENLABS_FALLBACK_MODEL_NE=eleven_v3
AGENT_LISTEN_MODEL_NE=nova-3

# ---------- Anthropic (console.anthropic.com) ----------
ANTHROPIC_API_KEY=
# Fast model for live suggestions, smarter model for post-call summaries
CLAUDE_FAST_MODEL=claude-haiku-5-5
CLAUDE_SMART_MODEL=claude-sonnet-5-5

# Country code added to 10-digit numbers
DEFAULT_COUNTRY_CODE=1
