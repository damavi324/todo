# Copy to .env.local and fill in your Web application OAuth client ID
# (Google Cloud Console → APIs & Services → Credentials → Create OAuth client → Web)
VITE_GOOGLE_WEB_CLIENT_ID=your-id.apps.googleusercontent.com

# Optional. From https://aistudio.google.com/apikey — used to turn spoken tasks into a title, date, and time.
# Restrict the key to the Generative Language API. It is compiled into the personal APK.
VITE_GEMINI_API_KEY=
